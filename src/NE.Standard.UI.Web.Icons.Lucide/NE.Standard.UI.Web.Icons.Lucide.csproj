<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>NE.Standard.UI.Web.Icons.Lucide</PackageId>
    <Description>DEPRECATED. Lucide for the NE.Standard UI web platform, drawing its glyphs as CSS masks over an embedded table. The Material pack moved to a variable font on 2026-09-02 and reads visibly better at 14 and 16 pixels; Lucide ships no font of its own, so this pack is frozen rather than followed. Use NE.Standard.UI.Web.Icons.Material. MIT, unlike the framework it plugs into.</Description>
    <PackageTags>NE.Standard,UI,Web,Icons,Lucide</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NE.Standard.UI.Icons.Lucide\NE.Standard.UI.Icons.Lucide.csproj" />
  </ItemGroup>

  <!-- The framework is a sibling in the monorepo and a package in this slice's mirror. Either way the
       produced nupkg depends on NE.Standard.UI.Web.Abstractions at $(CoreVersion). -->
  <ItemGroup Condition="'$(InMonorepo)' == 'true'">
    <ProjectReference Include="..\..\..\..\src\Platforms\Web\NE.Standard.UI.Web.Abstractions\NE.Standard.UI.Web.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(InMonorepo)' != 'true'">
    <PackageReference Include="NE.Standard.UI.Web.Abstractions" Version="$(CoreVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Client\dist\**" />
    <Content Remove="Client\dist\**" />
  </ItemGroup>

  <PropertyGroup>
    <LucideIconTable>$(MSBuildProjectDirectory)\Client\dist\ui-icons-lucide.deflate</LucideIconTable>
  </PropertyGroup>

  <Target Name="BuildLucideIconAssets" BeforeTargets="PrepareResources" Condition="'$(SkipWebIconBuild)' != 'true'">
    <Exec
      WorkingDirectory="$(MSBuildProjectDirectory)\Client"
      Command="npm install"
      Condition="!Exists('$(MSBuildProjectDirectory)\Client\node_modules')" />

    <Exec
      WorkingDirectory="$(MSBuildProjectDirectory)\Client"
      Command="npm run build" />

    <Error Condition="!Exists('$(LucideIconTable)')" Text="Lucide glyph table was not generated: $(LucideIconTable)" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="$(LucideIconTable)" LogicalName="NE.Standard.UI.Web.Icons.Lucide.Client.dist.ui-icons-lucide.deflate" />
  </ItemGroup>

</Project>
