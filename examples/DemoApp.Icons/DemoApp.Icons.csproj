<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- The sets are this slice's own, so they are projects here and in the mirror alike. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\NE.Standard.UI.Icons.Lucide\NE.Standard.UI.Icons.Lucide.csproj" />
    <ProjectReference Include="..\..\src\NE.Standard.UI.Web.Icons.Lucide\NE.Standard.UI.Web.Icons.Lucide.csproj" />
  </ItemGroup>

  <!-- The framework is a sibling in the monorepo and a package in the mirror, where this demo is the whole
       point: it shows that the published sets work against the published framework. -->
  <ItemGroup Condition="'$(InMonorepo)' == 'true'">
    <ProjectReference Include="..\..\..\..\src\Core\NE.Standard.UI\NE.Standard.UI.csproj" />
    <ProjectReference Include="..\..\..\..\src\Core\NE.Standard.UI.Components\NE.Standard.UI.Components.csproj" />
    <ProjectReference Include="..\..\..\..\src\Platforms\Web\NE.Standard.UI.Web\NE.Standard.UI.Web.csproj" />
    <ProjectReference Include="..\..\..\..\src\Platforms\Web\NE.Standard.UI.Web.Renderers\NE.Standard.UI.Web.Renderers.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(InMonorepo)' != 'true'">
    <PackageReference Include="NE.Standard.UI" Version="$(CoreVersion)" />
    <PackageReference Include="NE.Standard.UI.Components" Version="$(CoreVersion)" />
    <PackageReference Include="NE.Standard.UI.Web" Version="$(CoreVersion)" />
    <PackageReference Include="NE.Standard.UI.Web.Renderers" Version="$(CoreVersion)" />
  </ItemGroup>

</Project>
